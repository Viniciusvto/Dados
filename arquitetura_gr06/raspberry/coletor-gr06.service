# coletor-gr06.service  -  inicia o coletor_pi.py sozinho quando o Pi liga e reinicia se cair.
#
# Instalação (no Pi):
#   sudo cp ~/Documents/Dados/coletor-gr06.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now coletor-gr06
# Ver se está rodando:   systemctl status coletor-gr06
# Ver o log ao vivo:     journalctl -u coletor-gr06 -f
# Parar:                 sudo systemctl stop coletor-gr06

[Unit]
Description=Coletor GR06 (IHM Modbus -> TCP 5000 -> ESP2)
After=network-online.target
Wants=network-online.target

[Service]
User=print3d
WorkingDirectory=/home/print3d/Documents/Dados
ExecStart=/home/print3d/Documents/Dados/venv/bin/python coletor_pi.py --esp 192.168.80.5 --porta-esp 5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
